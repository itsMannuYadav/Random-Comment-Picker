{
  "manifest_version": 3,
  "name": "MySocial — Social Media Toolbox",
  "short_name": "MySocial",
  "version": "0.4.0",
  "description": "Pick winners, download video and thumbnails from YouTube, Reddit, Instagram, Vimeo and more, natively -- no need to leave the extension.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MySocial"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "webRequest", "downloads", "scripting", "offscreen"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://mycp.mannuyadav.me/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content/youtube-watch.js"],
      "run_at": "document_start"
    }
  ]
}
