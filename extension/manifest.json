{
  "manifest_version": 3,
  "name": "MyCP — Random Comment Picker",
  "short_name": "MyCP",
  "version": "0.1.0",
  "description": "Detect supported YouTube and Reddit posts and jump straight into the MyCP comment picker.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MyCP — Random Comment Picker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"]
}
